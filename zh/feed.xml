---
layout: null
permalink: /zh/feed.xml
---
{%- comment -%}
  Atom feed for the Chinese edition. Written by hand rather than via
  jekyll-feed's `collections` option, which titles the feed after the
  collection's internal name ("Near Criticality | Zh_posts").
{%- endcomment -%}
<?xml version="1.0" encoding="utf-8"?>
{%- assign t = site.data.i18n.zh -%}
{%- assign posts = site.zh_posts | sort: 'date' | reverse -%}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ t.html_lang }}">
  <title>{{ site.title | xml_escape }}（{{ t.name }}）</title>
  <subtitle>{{ t.description | xml_escape }}</subtitle>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ t.home | absolute_url }}" rel="alternate" type="text/html" hreflang="{{ t.html_lang }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <author><name>{{ t.author | default: site.author | xml_escape }}</name></author>
  {%- for post in posts limit: 10 %}
  <entry>
    <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}"/>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <content type="html" xml:base="{{ post.url | absolute_url | xml_escape }}">{{ post.content | strip | xml_escape }}</content>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    {%- if post.subtitle %}
    <summary type="html">{{ post.subtitle | strip_html | normalize_whitespace | xml_escape }}</summary>
    {%- endif %}
    {%- if post.image %}
    <media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ post.image | absolute_url | xml_escape }}"/>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>
